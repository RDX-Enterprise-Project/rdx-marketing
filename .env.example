# PostgreSQL is the system of record. Omit for a local SQLite run.
RDX_MARKETING_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rdx_marketing

# Buffer is the publishing gateway for LinkedIn, Facebook, and Instagram.
BUFFER_ACCESS_TOKEN=

# Channels are addressed by platform and role. LinkedIn has two: the company
# page and the founder's profile. A role with no id configured is skipped, never
# redirected to the other one.
BUFFER_CHANNEL_LINKEDIN_COMPANY=
BUFFER_CHANNEL_LINKEDIN_FOUNDER=
BUFFER_CHANNEL_FACEBOOK=
BUFFER_CHANNEL_INSTAGRAM=

# Optional drafting provider credentials. AI is disabled by default and the
# deterministic templates stand on their own.
RDX_AI_PROVIDER_KEY=
