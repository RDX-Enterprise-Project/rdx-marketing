{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rdx-marketing-capture",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
